# Local dev points at the plain Postgres container on localhost (the `db`
# service in compose.yaml). Vercel Preview/Production: the Supabase Marketplace
# integration provisions POSTGRES_URL, bridged in src/lib/db/connectionString.ts.
DATABASE_URL=postgres://videbacken:videbacken@localhost:14620/videbacken

# Better Auth — generate via `openssl rand -base64 32`. 32+ chars required.
BETTER_AUTH_SECRET=
# Site origin. Local: http://localhost:14600. Vercel prod: the URL Vercel
# assigns your project (or your custom domain) — see the Vercel dashboard.
BETTER_AUTH_URL=http://localhost:14600

# Google OAuth (Google Cloud console → APIs & Services → Credentials → OAuth
# client ID). Sign-in is still gated by the approved_email allowlist regardless
# of provider. Leave blank locally — real Google login isn't exercised in dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails seeded into the approved_email allowlist as admins on
# each server instance's first request (see server/plugins/seedApprovedEmails.ts). Bootstraps the first
# admin so someone can sign in on a fresh deployment (both Google and
# magic-link require an approved_email row).
INITIAL_ADMIN_EMAILS=mail@lukaslindqvist.se

# Optional. Logger level: trace | debug | info | warn | error | fatal.
# Defaults to debug in development, info in production.
LOG_LEVEL=

# Vercel Blob — two stores provisioned via Marketplace integration:
#   videbacken-public   (default access: public — user avatars)
#   videbacken-private  (default access: private — user documents)
# Local dev: leave blank — the app uses the S3_* block below (S3_ENDPOINT wins).
BLOB_PUBLIC_READ_WRITE_TOKEN=
BLOB_PRIVATE_READ_WRITE_TOKEN=

# Local S3-compatible storage (RustFS in `compose.yaml`). When S3_ENDPOINT is
# set, the storage adapter selects `s3` for local dev (takes precedence over
# BLOB_* tokens). Leave blank in production — Vercel will provision the BLOB_*
# tokens via the Marketplace integration and the `vercelBlob` adapter wins.
# Start the container with `bun run storage:up` (or `bun run dev:up`); the
# storage-init sidecar creates both buckets idempotently.
S3_ENDPOINT=http://localhost:14623
S3_REGION=eu-north-1
S3_ACCESS_KEY_ID=videbacken-dev
S3_SECRET_ACCESS_KEY=videbacken-dev-secret-key
S3_BUCKET_PUBLIC=videbacken-public
S3_BUCKET_PRIVATE=videbacken-private

# Optional override. Forces the devLog adapter regardless of the above —
# used by the test harness, useful for offline dev when docker isn't running.
# STORAGE_ADAPTER=devLog

# Local-dev broker for the blurhash queue. When set, queue.publish() routes
# through the bullmqQueue adapter; `bun run dev:worker` consumes from the same
# URL and runs the shared blurhash handler. Leave blank to keep the no-op
# devLog behaviour (uploads still work; blurhash just isn't generated).
# Start the broker with `bun run queue:up` (docker compose service `queue`).
REDIS_URL=redis://localhost:14621

# Local SMTP transport — Mailpit (compose.yaml service `mail`, started by
# `bun run mail:up` or `bun run dev:up`). When SMTP_HOST is set, the email
# adapter selects `smtp` (takes precedence over RESEND_API_KEY for the
# same reason S3_ENDPOINT wins over BLOB_*: `vercel env pull` doesn't
# accidentally route dev sends through the real Resend account). Inspect
# caught messages at http://localhost:14602.
SMTP_HOST=localhost
SMTP_PORT=14622

# Sender address. Mailpit accepts anything; Resend requires a verified
# domain (see ADR-0008 Deferred work).
EMAIL_FROM=Videbacken <no-reply@videbacken.local>

# Production transport. Selected only when SMTP_HOST is unset. Add this
# to Vercel env once the sender domain is verified.
RESEND_API_KEY=

# Optional override. Forces the devLog adapter regardless of the above.
# Tests also short-circuit via VITEST, so this is only needed for
# explicit offline dev without docker running.
# EMAIL_ADAPTER=devLog


# Shared secret for the Shelly H&T Gen3 sensor webhook. The device authenticates
# by including this as a `token` query param (it cannot send custom headers).
# Generate: openssl rand -base64 32. Set the same value in the Vercel project env.
SHELLY_WEBHOOK_TOKEN=

# Encryption key for GUI-set integration credentials (ADR-0026). Generate: openssl rand -base64 32
# (must decode to exactly 32 bytes). Set one per Vercel environment (each has its own database)
# and never reuse BETTER_AUTH_SECRET. It enables storing credentials from /charging/settings; a
# stored value overrides its env var below field by field (GRID_FACILITY_ID, ZAPTEC_USERNAME/
# ZAPTEC_PASSWORD, SKODA_API_KEY/SKODA_VIN/SKODA_HOME_COORDINATES, the four EMALDO_*; not
# ZAPTEC_ADAPTER). Unset = nothing can be saved and everything runs from env, unless a row is
# already stored: that source then fails closed as credentials_unreadable. Losing the key means
# re-entering stored values.
CREDENTIALS_ENCRYPTION_KEY=

# Our facility's 18-digit metering-point ID (anläggnings-ID, on the grid bill).
# The monthly /api/cron/grid-tariff-catalogue check matches it locally against
# the Eltariff-API catalogue and emails admins once our grid company publishes
# tariffs covering it. It is never sent anywhere, logged, or committed. Unset or
# not 18 digits = the check is skipped (logged as not_configured). Prod only.
GRID_FACILITY_ID=

# Shared secret for Vercel Cron → /api/cron/* (the Zaptec, elpris, Škoda
# and Emaldo syncs and the grid-tariff check).
# Vercel sends it as `Authorization: Bearer $CRON_SECRET`; unset = every cron
# request is rejected (fail closed). Generate: openssl rand -base64 32. Set the
# same value in the Vercel project env. Locally, curl the route with the header.
CRON_SECRET=

# Zaptec EV-charger API (api.zaptec.com) — the account owner's Zaptec portal
# login, used with the OAuth password grant by src/lib/effects/zaptec/. When
# both are set, the http adapter syncs real charging sessions; leave blank to
# get the notConfigured adapter (every call fails `not_configured`, shown as
# "not configured" on /charging). Never set these on Preview deploys (the
# preview DB is a prod branch). Never commit real values.
ZAPTEC_USERNAME=
ZAPTEC_PASSWORD=

# Optional override. `fake` serves synthetic chargers/sessions/live state for
# local UI work without credentials. There is deliberately no devLog adapter —
# a silent no-op would read as a healthy sync.
# ZAPTEC_ADAPTER=fake

# MyŠkoda Public API (public.api.connect.skoda-auto.cz) — polled every 15 min
# for the Enyaq's charging state, so new sessions will be attributed ours vs
# guest automatically. Create the key in the MyŠkoda app (v8.16+): open
# https://go.skoda.eu/api-keys on the phone, select the car. Keys are bound to
# the cars chosen at creation and expire (renew in the app, then replace here).
# The VIN is in the app's vehicle details. Either blank = every poll fails
# `not_configured`. Never set these on Preview deploys. Never commit real values.
# Renewing the key: docs/runbooks/skoda-api-key.md. Prod values go in Vercel
# Production (admins are emailed 30 and 7 days before the key expires).
SKODA_API_KEY=
SKODA_VIN=

# Home point for the geofence that tells "plugged in here" from "plugged in
# elsewhere": "lat,lon" in decimal degrees (e.g. the charger's position from a
# map). The car's own GPS position is compared against it in memory and only a
# boolean is stored — coordinates are never stored or logged. Blank = the
# geofence is off and attribution falls back to plug state and whether the car
# is moving. Format example (central Stockholm, not a real home):
# 59.3293,18.0686. Left blank on purpose: a copied placeholder would mark every
# session as a guest. Never commit the real value.
SKODA_HOME_COORDINATES=

# Emaldo home battery cloud (ADR-0023): the house's 5-minute grid / solar /
# battery / load flows, for solar-aware charging cost. Unofficial API (protocol
# from github.com/wertigpar/ha-emaldo, MIT). Use a DEDICATED Emaldo account
# shared to the home: a login ends that account's other sessions (the phone app
# included). APP_ID / APP_SECRET are the Emaldo Android app's own values (see
# DEFAULT_APP_ID / DEFAULT_APP_SECRET in ha-emaldo's const.py); a new app
# release can rotate them, and the sync then fails with a hint saying so. Any
# blank = every call fails `not_configured`. Never commit real values.
# Synced hourly at :45 by /api/cron/emaldo-sync (5-minute readings into
# house_energy_reading); the first runs backfill from a week before the first
# charging session, 30 days a run. Vercel Production only: a login ends the
# account's other sessions, so a Preview deploy would log prod out.
EMALDO_USER=
EMALDO_PASSWORD=
EMALDO_APP_ID=
EMALDO_APP_SECRET=
